@startuml cas_utilisation
skinparam actorStyle awesome
skinparam backgroundColor white
skinparam usecase {
  BorderColor #2d3a8c
  BackgroundColor #4f5fc4
  FontColor white
  ArrowColor #2d3a8c
}
skinparam actor {
  BorderColor #2d3a8c
  BackgroundColor #e8eaf6
  FontColor #1a1a2e
}

left to right direction

actor "Utilisateur" as U

rectangle "YouthConnect" {

  usecase "S'inscrire" as UC1
  usecase "Se connecter" as UC2
  usecase "Se déconnecter" as UC3

  usecase "Parcourir les activités" as UC4
  usecase "Rechercher une activité" as UC5
  usecase "Filtrer par catégorie" as UC6

  usecase "Rejoindre une activité" as UC7
  usecase "Quitter une activité" as UC8

  usecase "Créer une activité" as UC9
  usecase "Supprimer une activité" as UC10

  usecase "Voir activités rejointes" as UC11
  usecase "Voir activités créées" as UC12
  usecase "Consulter son profil" as UC13

}

U --> UC1
U --> UC2
U --> UC3
U --> UC4
U --> UC5
U --> UC7
U --> UC8
U --> UC9
U --> UC10
U --> UC11
U --> UC12
U --> UC13

UC4 .> UC6 : <<include>>
UC5 .> UC6 : <<include>>
UC13 .> UC11 : <<include>>
UC13 .> UC12 : <<include>>

@enduml
